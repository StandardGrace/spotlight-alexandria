# Copy this file to .env. Every setting is optional - the values shown are the defaults.

PORT=3001

# How often to check the advisory page (standard cron syntax). Default: every 6 hours.
CRON_SCHEDULE=0 */6 * * *

# Which site may call this API. Set to https://spotlightalexandria.ca once that's live.
ALLOWED_ORIGIN=*

CACHE_FILE=./data/cache.json

EOHU_URL=https://eohu.ca/en/my-environment/public-beach-water-advisories
