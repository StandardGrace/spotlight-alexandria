# Copy this file to .env and fill in WEATHER_API_KEY. Everything else is optional;
# the commented-out values show the defaults used when a setting is left out.

# Required: free key from https://www.weatherapi.com
WEATHER_API_KEY=

# PORT=4000
# ALLOWED_ORIGIN=*

# Weather
# WEATHER_LOCATION=Alexandria,Ontario
# WEATHER_CACHE_FILE=./data/weather-cache.json
# WEATHER_CRON_SCHEDULE=*/30 * * * *

# Address of the island-park-scraper service
# ISLAND_PARK_API_URL=http://localhost:3001/api/island-park

# Restaurants: folder of restaurant .md files, read by `npm run ingest:restaurants`.
# Keep this folder outside the repo (see docs/TECHNICAL_DESIGN.md).
# RESTAURANT_CONTENT_DIR=
# RESTAURANT_DB_FILE=./data/restaurants.sqlite3
